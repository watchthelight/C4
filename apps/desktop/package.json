{
  "name": "@c4/desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node electron/dev.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build && tsc -p electron/tsconfig.json",
    "build:main": "tsc -p electron/tsconfig.json",
    "start": "electron .",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit && tsc --noEmit -p electron/tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@preact/signals-core": "^1.14.4",
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "electron": "^45.0.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
