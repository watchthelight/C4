{
  "name": "@c4/desktop",
  "private": true,
  "version": "0.0.1",
  "description": "C4, a command center for Claude Code sessions",
  "author": "watchthelight <admin@watchthelight.org>",
  "license": "MIT",
  "homepage": "https://github.com/watchthelight/C4",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node electron/dev.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build && tsc -p electron/tsconfig.json",
    "build:main": "tsc -p electron/tsconfig.json",
    "start": "electron .",
    "package": "node electron/package.mjs",
    "package:dir": "node electron/package.mjs --dir",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p electron/tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@preact/signals-core": "^1.14.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
